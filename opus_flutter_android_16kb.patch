diff --git a/opus_flutter_android/android/Android.mk b/opus_flutter_android/android/Android.mk
index 3a8a4df..c2a8c0b 100644
--- a/opus_flutter_android/android/Android.mk
+++ b/opus_flutter_android/android/Android.mk
@@ -24,6 +24,8 @@ LOCAL_CFLAGS        := -DPACKAGE_VERSION=$(LOCAL_OPUS_VERSION) \
                        -Drestrict='' -D__EMX__ -DOPUS_BUILD \
                        -DUSE_ALLOCA -DHAVE_LRINT -DHAVE_LRINTF -O2 -fno-math-errno
 LOCAL_CPPFLAGS      := -DBSD=1 -ffast-math -O2 -funroll-loops
+# Align to 16KB page size for Android 15+ compatibility.
+LOCAL_LDFLAGS       += -Wl,-z,max-page-size=16384
 
 
 ifeq ($(LOCAL_FIXED),true)
diff --git a/opus_flutter_android/android/build.gradle b/opus_flutter_android/android/build.gradle
index 3f3cd86..78bc5f6 100644
--- a/opus_flutter_android/android/build.gradle
+++ b/opus_flutter_android/android/build.gradle
@@ -26,6 +26,9 @@ android {
     if (project.android.hasProperty("namespace")) {
         namespace 'eu.epnw.opus_flutter_android'
     }
+
+    // Ensure a modern NDK with 16KB page size support.
+    ndkVersion "29.0.14206865"
 
     compileSdkVersion 33
 
